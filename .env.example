# Copy to .env and adjust per machine:  cp .env.example .env
# host-setup.sh prints the correct RENDER_GID / VIDEO_GID for your box.

# --- Camera ---
CAMERA_SOURCE=0
FRAME_WIDTH=1280
FRAME_HEIGHT=720
# (Camera uses MJPG for higher FPS; if the preview is choppy, lower these or use a faster camera.)

# --- Object detection (fast path) ---
# construction_openvino_model = YOLO-World with construction classes baked in.
# Use yolo11n_openvino_model for generic COCO classes instead.
DETECTOR_MODEL=/app/models/construction_openvino_model
# intel:gpu | intel:npu | intel:cpu  (npu offloads the iGPU for the VLM)
DETECTOR_DEVICE=intel:npu
# Open-vocab detectors do better with a lower confidence threshold.
DETECTOR_CONF=0.25
# Person<->machinery proximity for the danger-zone flag (fraction of frame).
DANGER_MARGIN=0.05

# --- Vision-language model (slow path) ---
# 2B = fast (~5s/answer). For sharper scene reasoning switch to the 7B model:
#   VLM_MODEL=/app/models/qwen2.5-vl-7b-int4
# 7B is ~20-30s/answer on the iGPU, so set VLM_INTERVAL_S=0 (on-demand only, via
# the ask box / 'capture' command) or ~45 for periodic; consider VLM_MAX_NEW_TOKENS=100.
VLM_MODEL=/app/models/qwen2-vl-2b-int4
# GPU | NPU | CPU | AUTO
VLM_DEVICE=GPU
VLM_MAX_NEW_TOKENS=150
VLM_INTERVAL_S=15
# Structured safety check: first line 'HAZARD: YES/NO' is parsed into telemetry.
VLM_DEFAULT_PROMPT=You are the safety monitor for a construction site with smart machines. Reply with a first line that is exactly 'HAZARD: YES' or 'HAZARD: NO', then one sentence describing the scene and any people, missing PPE (hard hats or safety vests), or workers too close to machinery.

# --- IOTCONNECT ---
# Drop your device's files (iotcDeviceConfig.json + the .crt and key .pem) into
# the credentials/ folder; they are auto-detected. Set IOTC_ENABLED=0 to run
# the perception demo with no cloud at all. The explicit IOTC_* paths below are
# optional overrides — leave blank to auto-detect.
IOTC_ENABLED=1
IOTC_CREDENTIALS_DIR=/app/credentials
IOTC_CONFIG_JSON=
IOTC_CERT=
IOTC_PKEY=
TELEMETRY_INTERVAL_S=10
# Device location -> IOTCONNECT LATLONG attribute "lat,lon". Set both for a fixed
# install (exact). Or set GEO_AUTODETECT=1 for an approximate IP-based location.
DEVICE_LAT=
DEVICE_LON=
GEO_AUTODETECT=0

# --- Viewer ---
MJPEG_ENABLED=1
MJPEG_PORT=8080
# Blank space (px) at the top of the viewer page (for embedding in a dashboard widget).
VIEWER_TOP_PAD=0
SHOW_WINDOW=0

# --- Device group IDs (from host-setup.sh) ---
RENDER_GID=993
VIDEO_GID=44

LOG_LEVEL=INFO
